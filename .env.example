# LangGraph Configuration
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent
# Optional. Required for Agent Builder deployments.
# (DEPRECATED: NEXT_PUBLIC_AUTH_SCHEME) The setup form sets the auth scheme
# to "langsmith-api-key" automatically when you toggle "Built with Agent Builder".
# NEXT_PUBLIC_AUTH_SCHEME=
# Supabase auth (client-side login gate)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Do NOT prefix this with "NEXT_PUBLIC_" as we do not want this exposed in the client.
# (DEPRECATED) LANGSMITH_API_KEY=

# Production LangGraph Configuration (quickstart) - Uncomment to use
# NEXT_PUBLIC_ASSISTANT_ID="agent"
# This should be the deployment URL of your LangGraph server
# (DEPRECATED) LANGGRAPH_API_URL="https://my-agent.default.us.langgraph.app"
# This should be the URL of your website + "/api". This is how you connect to the API proxy
# NEXT_PUBLIC_API_URL="https://my-website.com/api"
# (DEPRECATED) Your LangSmith API key which is injected into requests inside the API proxy
# LANGSMITH_API_KEY="lsv2_..."
# Cloudflare Turnstile (public site key, pairs with the widget secret in Supabase dashboard)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
