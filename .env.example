# LangGraph Configuration
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent

# Amplify Auth (Cognito) - Configured via amplify_outputs.json
# The following are optional and can be used to override the amplify_outputs.json values
# NEXT_PUBLIC_AWS_REGION=us-east-1
# NEXT_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXXX
# NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cloudflare Turnstile (public site key, pairs with the widget secret in Cognito/Amplify)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Production LangGraph Configuration (quickstart) - Uncomment to use
# NEXT_PUBLIC_ASSISTANT_ID="agent"
# NEXT_PUBLIC_API_URL="https://my-website.com/api"